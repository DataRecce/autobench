# Razorback run outputs — large, reproducible from frozen specs.
runs/
bad_runs/

# Materialized Harbor task views — swe-bench-pro hydrates from the published
# `scale-ai/swe-bench-pro` package and the run orchestrator materializes views
# into a tmp tasks_root; nothing to track. (No local _views/ like spider2-dbt.)
_views/

# Per-run provenance — regenerated by each rk run, not source.
specs/provenance.yaml

# Detached rk-run handles / PID files — operational, not source.
.rk-handles/
.pid
*.pid

# ntfy topic for detached-run completion pushes.
.ntfy-topic

# Local named-reference registry — operator-bound via `rk registry add`, not source.
razorback-registry.yaml

# Python / editor / build noise.
__pycache__/
*.py[cod]
.DS_Store
*.swp
*.swo
.venv/
